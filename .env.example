# Copy this file to .env for local development and fill in your own values.
# Get both from: Supabase Dashboard -> your project -> Settings -> API

# Project URL, e.g. https://abcdefghij.supabase.co
VITE_SUPABASE_URL=

# "anon" / "public" key (safe to expose in a frontend app — Row Level
# Security in supabase/schema.sql is what actually protects the data)
VITE_SUPABASE_ANON_KEY=

# Leave both blank to run the app in local demo mode (no real accounts,
# everything stored in the browser only) exactly as it worked before.
